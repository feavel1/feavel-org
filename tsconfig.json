{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"],
			"#convex/*": ["./src/convex/*"]
		},
		"types": ["$app/types", "node", "@sveltejs/enhanced-img", "./worker-configuration.d.ts"]
	},
	"include": ["src", "vite.config.ts", "playwright.config.ts"],
	"exclude": ["src/lib/paraglide", ".svelte-kit", ".wrangler", "build", "dist", "node_modules"]
}
