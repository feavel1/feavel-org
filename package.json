{
	"name": "feavel-hub-sk3",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && wrangler types --check && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types --include-env=false",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.60.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@vitest/browser-playwright": "^5.0.5",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsrepo": "^3.8.1",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"runed": "^0.37.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-easy-crop": "^5.0.1",
		"svelte-sonner": "^1.2.1",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.151.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#convex/*": "./src/convex/*"
	},
	"dependencies": {
		"@better-auth/api-key": "1.6.16",
		"@convex-dev/better-auth": "0.12.5",
		"@convex-dev/migrations": "^0.3.7",
		"@convex-dev/resend": "0.2.9",
		"@icons-pack/svelte-simple-icons": "^6.5.0",
		"@mmailaender/convex-better-auth-svelte": "^0.10.0",
		"@zxcvbn-ts/core": "^4.1.2",
		"@zxcvbn-ts/language-common": "^4.1.3",
		"@zxcvbn-ts/language-en": "^4.1.1",
		"better-auth": "1.6.16",
		"convex": "^1.47.0",
		"convex-helpers": "^0.1.128",
		"convex-svelte": "^0.15.1",
		"path-to-regexp": "^8.4.2"
	}
}